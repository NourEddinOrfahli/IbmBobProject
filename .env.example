# ---------------------------------------------------------------
# Space Interpreter — environment variable template
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to version control.
# ---------------------------------------------------------------

# NASA API key
# Get a free key at https://api.nasa.gov
# "DEMO_KEY" works for light testing but has strict rate limits.
NASA_API_KEY=DEMO_KEY

# Timeout in seconds for requests to NASA endpoints (default: 5).
# Lower values keep the UI responsive; raise only if on a very slow connection.
# NASA_REQUEST_TIMEOUT=5

# Set to "false" to disable the fallback mock APOD on NASA timeout/network error.
# When true (default) a placeholder story is returned instantly instead of hanging.
# NASA_APOD_FALLBACK=true

# OpenRouter API key — required for AI endpoints
# Sign up at https://openrouter.ai and create a key.
OPENROUTER_API_KEY=

# OpenRouter primary model identifier
# Use any model slug from https://openrouter.ai/models
# Default: google/gemini-2.0-flash-exp:free
#   - Fast, free, large context window, reliable Arabic JSON generation
#   - Strong multimodal support for image analysis
# DO NOT use openrouter/auto or openrouter/free as defaults — these may route
# to safety-classifier models that return non-JSON responses like "User Safety: safe".
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# Vision model used for image analysis (multimodal endpoint).
# Must be a model that supports the OpenAI vision (image_url) format.
# Default: google/gemini-2.0-flash-exp:free
OPENROUTER_VISION_MODEL=google/gemini-2.0-flash-exp:free

# Fallback model used when the primary model is rate-limited or unavailable.
# The backend will automatically switch to this if the primary fails.
OPENROUTER_FALLBACK_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Maximum output tokens for the AI model.
# Increased to 2000 to give more headroom for Arabic story JSON output.
# Free models typically support 2048–8192 output tokens.
OPENROUTER_MAX_TOKENS=2000

# Minimum completion tokens for a response to be considered valid.
# Responses with fewer tokens than this are likely classifiers/safety models
# and will be rejected before retry is attempted.
# OPENROUTER_MIN_COMPLETION_TOKENS=100

# Optional: override the OpenRouter base URL (useful for local proxies)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: application log level (DEBUG | INFO | WARNING | ERROR)
# LOG_LEVEL=INFO

# Optional: enable debug mode (true | false)
# DEBUG=false

# ---------------------------------------------------------------------------
# Daily bulletin automation
# ---------------------------------------------------------------------------

# Enable the automatic daily scheduler (default: false)
# DAILY_BULLETIN_ENABLED=false

# Time to run the daily bulletin (24-hour format, UTC by default)
# DAILY_BULLETIN_HOUR=7
# DAILY_BULLETIN_MINUTE=0

# Timezone for the scheduler (any valid IANA timezone, e.g. Asia/Riyadh)
# DAILY_BULLETIN_TIMEZONE=UTC

# Path to the local JSON cache file for generated bulletins
# BULLETIN_STORE_PATH=bulletin_store.json
